# プロキシ設定が必要な場合だけ有効化する
# HTTP_PROXY=http://localhost:7890
# HTTPS_PROXY=http://localhost:7890

# ログインを許可するメールアドレス一覧をカンマ区切りで指定する
# 設定した場合は一覧に含まれるメールアドレスだけログインできる
# 空のままにするとすべてのユーザーが登録できる
# AUTH_ALLOWED_EMAILS=user1@example.com,user2@example.com

# 認証関連
# Casdoor を有効にして LobeHub 側の email/password 登録を無効にする
AUTH_SSO_PROVIDERS=casdoor
AUTH_DISABLE_EMAIL_PASSWORD=1

############
# 基本設定 
############
LOBE_PORT=3210
# Casdoor と監視統合構成では RustFS API は 9000 固定を前提にしている
RUSTFS_PORT=9000
RUSTFS_ADMIN_PORT=9001
CASDOOR_PORT=8000
GRAFANA_PORT=3000
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
APP_URL=http://localhost:3210
# INTERNAL_APP_URL はサーバー内部同士の通信に使う
# Docker Compose でのデプロイ時に必要になる
# APP_URL にホスト IP や LAN IP を指定している場合
# 未設定だと AI 画像生成などの機能が失敗することがある
INTERNAL_APP_URL=http://localhost:3210

# シークレットは必ず安全な値へ置き換える
# 32 バイトのランダム値を base64 化した値を推奨する
KEY_VAULTS_SECRET=replace_with_base64_32byte_secret
AUTH_SECRET=replace_with_base64_32byte_secret

# PostgreSQL 関連
LOBE_DB_NAME=lobechat
POSTGRES_PASSWORD=change_this_postgres_password

# RustFS の S3 設定
S3_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=change_this_rustfs_secret

# RustFS で使用するバケット名
RUSTFS_LOBE_BUCKET=lobe

# Casdoor 設定
# 初期データは casdoor/init_data.json.exmaple をベースに casdoor/init_data.json へ生成する
AUTH_CASDOOR_ISSUER=http://localhost:8000
AUTH_CASDOOR_ID=change_this_casdoor_client_id
AUTH_CASDOOR_SECRET=change_this_casdoor_client_secret
CASDOOR_WEBHOOK_SECRET=change_this_casdoor_webhook_secret
origin=http://localhost:8000

# Grafana 管理者パスワード
GF_SECURITY_ADMIN_PASSWORD=change_this_grafana_password

# Casdoor 用の JWKS を設定する
# 実運用では生成済みの秘密鍵一式へ置き換える
JWKS_KEY={"keys":[{"kty":"RSA","kid":"replace_me","use":"sig","alg":"RS256","n":"replace_me","e":"AQAB","d":"replace_me","p":"replace_me","q":"replace_me","dp":"replace_me","dq":"replace_me","qi":"replace_me"}]}

# Cloudflare Tunnel を使う場合だけ設定する
CLOUDFLARE_TUNNEL_TOKEN=

# scripts/out.jsonl から生成した ENV 候補
# 参照ドキュメント
# - https://lobehub.com/docs/self-hosting/environment-variables/basic
# - https://lobehub.com/docs/self-hosting/environment-variables/model-provider/
# 注意
# - このファイルには out.jsonl から安全に変換できる ENV だけを書く
# - SQL だけのエクスポートでは API キーやプロキシ URL の平文までは取得できない
# - custom provider は公式ドキュメントの ENV だけでは完全再現できないため ヒントのみ残す

################################
# デフォルトエージェント / システム AI
################################
DEFAULT_AGENT_CONFIG='model=gpt-5.4;provider=openai'
SYSTEM_AGENT='topic=openai/gpt-5.4-nano,translation=openai/gpt-5.4-nano,queryRewrite=openai/gpt-5.4-nano,generationTopic=openai/gpt-5.4-nano,agentMeta=openai/anthropic/claude-sonnet-4.6,historyCompress=openai/anthropic/claude-sonnet-4.6'

############################
# OpenAI 互換経路を使う構成
############################
# ドキュメントにある ENV
# - ENABLED_OPENAI
# - OPENAI_API_KEY
# - OPENAI_PROXY_URL
# - OPENAI_MODEL_LIST
# master アカウントでは provider=openai を使っており
# 有効化されていたモデル一覧を OPENAI_MODEL_LIST に反映している
# この構成を使うには次のどちらかを設定する
# - OpenAI へ直接つなぐなら OPENAI_API_KEY
# - OpenAI 互換ゲートウェイを使うなら OPENAI_PROXY_URL
ENABLED_OPENAI=1
OPENAI_MODEL_LIST='-all,+anthropic/claude-haiku-4.5=Claude Haiku 4.5<200000:reasoning:vision:fc:search>,+anthropic/claude-opus-4.6<1000000:reasoning:vision:fc:search>,+anthropic/claude-sonnet-4.6<1000000:reasoning:vision:fc:search>,+gpt-5.4,+gpt-5.4-mini,+gpt-5.4-nano,+gpt-5-mini,+openai/gpt-5.2-codex<reasoning:vision:fc>,+openai/gpt-5.3-codex<reasoning:vision:fc>,+openai/gpt-5-nano=GPT-5 nano<128000:reasoning:vision:fc>'
OPENAI_PROXY_URL=
OPENAI_API_KEY=sk-your-openai-api-key
